tosh" stEvt:changed="/"/> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:9EFE7BB50A2068119440C931971BE43F" stEvt:when="2015-12-03T19:22:16+11:00" stEvt:softwareAgent="Adobe Photoshop CS5 Macintosh" stEvt:changed="/"/> <rdf:li stEvt:action="converted" stEvt:parameters="from application/vnd.adobe.photoshop to image/jpeg"/> <rdf:li stEvt:action="derived" stEvt:parameters="converted from application/vnd.adobe.photoshop to image/jpeg"/> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:9FFE7BB50A2068119440C931971BE43F" stEvt:when="2015-12-03T19:22:16+11:00" stEvt:softwareAgent="Adobe Photoshop CS5 Macintosh" stEvt:changed="/"/> </rdf:Seq> </xmpMM:History> <xmpMM:DerivedFrom stRef:instanceID="xmp.iid:9EFE7BB50A2068119440C931971BE43F" stRef:documentID="adobe:docid:photoshop:eec300e3-3830-11dc-bffd-827ca1e4e042" stRef:originalDocumentID="adobe:docid:photoshop:eec300e3-3830-11dc-bffd-827ca1e4e042"/> <photoshop:TextLayers> <rdf:Bag> <rdf:li photoshop:LayerName="ER" photoshop:LayerText="ER"/> <rdf:li photoshop:LayerName="Spatial-Reach" photoshop:LayerText="Protective Extension +           Spatial Reach "/> <rdf:li photoshop:LayerName="Outer-Spatial" photoshop:LayerText="Outer-Spatial   Tonic Lab "/> <rdf:li photoshop:LayerName="+ Protective Extension" photoshop:LayerText="+ Protective Extension"/> <rdf:li photoshop:LayerName="Navel-Yielding" photoshop:LayerText="Navel-Yielding"/> <rdf:li photoshop:LayerName="Tuck right foot under and drop down." photoshop:LayerText="Tuck right foot under and drop down. Allow weight to drop down through left leg."/> <rdf:li photoshop:LayerName="It feels nice, it feels lovely giving in to that f-wphh! Itâ€™s p" photoshop:LayerText="It feels nice, it feels lovely giving in to that f-wphh! Itâ€™s pleasurable. Doing it too much maybe hurts your ankle, because as you tuck it under a little bit of pressure is put on the top of the foot. But itâ€™s really really safe after youâ€™ve done it a couple of times and you realise nothing weird is going to happen. And that last little thwump, nice and satisfying."/> <rdf:li photoshop:LayerName="Layer 1" photoshop:LayerText=""/> <rdf:li photoshop:LayerName="Contacting the ground with the knee/lower leg and folding the l" photoshop:LayerText="Contacting the ground with the knee/lower leg and folding the legs."/> <rdf:li photoshop:LayerName="Allow the weight to fall to the right side. Sliding out along t" photoshop:LayerText="Allow the weight to fall to the right side. Sliding out along the right side of the body, following the direction of the little finger."/> <rdf:li photoshop:LayerName="Extending out along the right side of the body, thenrelaxing in" photoshop:LayerText="Extending out along the right side of the body, thenrelaxing into the ground."/> <rdf:li photoshop:LayerName="Form:" photoshop:LayerText="Form:"/> <rdf:li photoshop:LayerName="Quality:" photoshop:LayerText="Quality:"/> <rdf:li photoshop:LayerName="Shape" photoshop:LayerText="Shape"/> <rdf:li photoshop:LayerName="Felt quality" photoshop:LayerText="Felt quality"/> <rdf:li photoshop:LayerName="Technique" photoshop:LayerText="Technique"/> <rdf:li photoshop:LayerName="pin-like" photoshop:LayerText="pin-like"/> <rdf:li photoshop:LayerName="ball-like" photoshop:LayerText="ball-like"/> <rdf:li photoshop:LayerName="pin-like 2" photoshop:LayerText="pin-like"/> <rdf:li photoshop:LayerName="sinking" photoshop:LayerText="sinking"/> <rdf:li photoshop:LayerName="spreading" photoshop:LayerText="spreading"/> </rdf:Bag> </photoshop:TextLayers> </rdf:Description> </rdf:RDF> </x:xmpmeta>                                                                                                                                                                                                                                                                                                                                                                                                                                              