5 Macintosh" stEvt:changed="/"/> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:08801174072068119440C931971BE43F" stEvt:when="2015-12-03T19:04:27+11:00" stEvt:softwareAgent="Adobe Photoshop CS5 Macintosh" stEvt:changed="/"/> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:97FE7BB50A2068119440C931971BE43F" stEvt:when="2015-12-03T19:10:41+11:00" stEvt:softwareAgent="Adobe Photoshop CS5 Macintosh" stEvt:changed="/"/> <rdf:li stEvt:action="converted" stEvt:parameters="from application/vnd.adobe.photoshop to image/jpeg"/> <rdf:li stEvt:action="derived" stEvt:parameters="converted from application/vnd.adobe.photoshop to image/jpeg"/> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:98FE7BB50A2068119440C931971BE43F" stEvt:when="2015-12-03T19:10:41+11:00" stEvt:softwareAgent="Adobe Photoshop CS5 Macintosh" stEvt:changed="/"/> </rdf:Seq> </xmpMM:History> <xmpMM:DerivedFrom stRef:instanceID="xmp.iid:97FE7BB50A2068119440C931971BE43F" stRef:documentID="adobe:docid:photoshop:eec300e3-3830-11dc-bffd-827ca1e4e042" stRef:originalDocumentID="adobe:docid:photoshop:eec300e3-3830-11dc-bffd-827ca1e4e042"/> <photoshop:TextLayers> <rdf:Bag> <rdf:li photoshop:LayerName="ER" photoshop:LayerText="ER"/> <rdf:li photoshop:LayerName="Spatial-Reach" photoshop:LayerText="Spatial-Reach "/> <rdf:li photoshop:LayerName="+ Protective Extension" photoshop:LayerText="+ Protective Extension"/> <rdf:li photoshop:LayerName="Layer 2" photoshop:LayerText=""/> <rdf:li photoshop:LayerName="Spatial-Turning" photoshop:LayerText="Spatial-Turning"/> <rdf:li photoshop:LayerName="+ Tonic Lab" photoshop:LayerText="+ Tonic Lab"/> <rdf:li photoshop:LayerName="Raising up on toes and lifting up through pelvis and chest as k" photoshop:LayerText="Raising up on toes and lifting up through pelvis and chest as knees bend"/> <rdf:li photoshop:LayerName="In this movement, thereâ€™s a feeling of lift through the body. A" photoshop:LayerText="In this movement, thereâ€™s a feeling of lift through the body. A kind of rotating and twisting around. I go up on the toes and I get kind of a lift through my pelvis, that is going to slow me down.Iâ€™m working with suspension. This moment of falling looks really exciting dramatically and theatrically when you can suspend. "/> <rdf:li photoshop:LayerName="Layer 1" photoshop:LayerText=""/> <rdf:li photoshop:LayerName="Rotating over right shoulder" photoshop:LayerText="Rotating over right shoulder"/> <rdf:li photoshop:LayerName="Arms swing behind to catch the ground" photoshop:LayerText="Arms swing behind to catch the ground"/> <rdf:li photoshop:LayerName="Finding the floor with the belly" photoshop:LayerText="Finding the floor with the belly"/> <rdf:li photoshop:LayerName="Continuing to roll to standing" photoshop:LayerText="Continuing to roll to standing"/> <rdf:li photoshop:LayerName="Form:" photoshop:LayerText="Form:"/> <rdf:li photoshop:LayerName="Quality:" photoshop:LayerText="Quality:"/> <rdf:li photoshop:LayerName="Shape" photoshop:LayerText="Shape"/> <rdf:li photoshop:LayerName="Felt quality" photoshop:LayerText="Felt quality"/> <rdf:li photoshop:LayerName="Technique" photoshop:LayerText="Technique"/> <rdf:li photoshop:LayerName="pin-like" photoshop:LayerText="pin-like"/> <rdf:li photoshop:LayerName="arc-like" photoshop:LayerText="arc-like"/> <rdf:li photoshop:LayerName="arc-like 2" photoshop:LayerText="arc-like"/> <rdf:li photoshop:LayerName="screw-like" photoshop:LayerText="screw-like"/> <rdf:li photoshop:LayerName="sinking, retreating, spreading" photoshop:LayerText="sinking, retreating, spreading"/> <rdf:li photoshop:LayerName="enclosing, then rising" photoshop:LayerText="enclosing, then rising"/> </rdf:Bag> </photoshop:TextLayers> </rdf:Description> </rdf:RDF> </x:xmpmeta>                                                                                                                                                                                                                                                         